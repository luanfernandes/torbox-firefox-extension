{
  "name": "torbox-web-helper",
  "version": "0.1.1",
  "private": true,
  "description": "Unofficial Firefox and Zen extension for finding and preparing TorBox-supported Hoster links.",
  "license": "MIT",
  "author": "Luan Fernandes",
  "homepage": "https://github.com/luanfernandes/torbox-firefox-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luanfernandes/torbox-firefox-extension.git"
  },
  "bugs": {
    "url": "https://github.com/luanfernandes/torbox-firefox-extension/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:extension": "web-ext lint --source-dir dist",
    "smoke:zen": "node scripts/smoke-zen.mjs",
    "package": "pnpm build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "package:release": "node scripts/package-release.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm lint:extension"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "lucide": "1.34.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "web-ext": "10.6.0"
  }
}
